{
  "name": "galflow",
  "version": "0.1.0",
  "private": true,
  "description": "A visual story-flow editor for galgame scripts.",
  "author": "GalFlow",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:share": "node scripts/share-smoke.mjs",
    "smoke:variables": "node scripts/variables-smoke.mjs",
    "smoke:canvases": "node scripts/canvas-smoke.mjs",
    "smoke:desktop": "node scripts/electron-smoke.mjs",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:pack": "npm run desktop:build && node scripts/build-installer.mjs",
    "desktop:installer": "node scripts/build-installer.mjs",
    "desktop:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "desktop:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-local.ps1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "electron": "^43.8.3",
    "happy-dom": "^21.0.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.61.0",
    "oxc-transform-react": "^0.152.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "zustand": "^5.0.16"
  }
}
